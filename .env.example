# ==============================================================================
# Condominio App — Plantilla Productiva de Variables de Entorno (.env.example)
# SPDX-License-Identifier: MIT
# Copyright (C) 2026 Condominio App Contributors
# ==============================================================================
# INSTRUCCIONES:
#   1. Copie esta plantilla en la raíz del proyecto y proteja sus permisos:
#      cp .env.example .env && chmod 600 .env
#   2. Sustituya todos los valores placeholder generados con: openssl rand -hex 32
#   3. NUNCA agregue .env al repositorio (excluido por .gitignore).
# ==============================================================================

# --- Núcleo FastAPI & Seguridad HTTP/JWT ---
APP_ENV=production
# Obligatorio >= 32 caracteres aleatorios en producción (Fail-Fast al arrancar)
SECRET_KEY=CAMBIAR_PLACEHOLDER_GENERAR_CON_OPENSSL_RAND_HEX_32
COOKIE_SECURE=true
CSRF_ENFORCE=true
ALLOWED_ORIGINS=https://condominio.ejemplo.local
FRONTEND_PORT=8080

# --- Base de Datos PostgreSQL 17 ---
POSTGRES_DB=condominio_db
POSTGRES_USER=condominio_admin
POSTGRES_PASSWORD=CAMBIAR_PLACEHOLDER_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://condominio_admin:CAMBIAR_PLACEHOLDER_POSTGRES_PASSWORD@postgres:5432/condominio_db

# --- Motor KeyDB Multi-Hilo ---
KEYDB_PASSWORD=CAMBIAR_PLACEHOLDER_KEYDB_PASSWORD
REDIS_URL=redis://:CAMBIAR_PLACEHOLDER_KEYDB_PASSWORD@keydb:6379/0

# --- Almacenamiento S3 MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=condominio_minio
MINIO_ROOT_PASSWORD=CAMBIAR_PLACEHOLDER_MINIO_PASSWORD
MINIO_BUCKET=condominio-media
MINIO_USE_SSL=false

# --- Worker Asíncrono & Notificaciones SMTP ---
WORKER_HEARTBEAT_PATH=/tmp/worker_heartbeat
WORKER_POLL_SECONDS=1
WORKER_MEDIA_ENABLED=false
SMTP_ENABLED=false
SMTP_HOST=smtp.ejemplo.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=CAMBIAR_PLACEHOLDER_SMTP_PASSWORD
SMTP_FROM=no-responder@condominio.ejemplo.local
SMTP_USE_TLS=true

# --- Respaldos Automatizados (scripts/backup-diario.sh) ---
BACKUP_DIR=/var/backups/condominio
BACKUP_RETENTION_DAYS=30
# Opcional: si se define, cifra los respaldos con AES-256-CBC + PBKDF2
BACKUP_PASSPHRASE=

# --- Bootstrap Inicial Día 0 (opcional: docker compose exec api python -m src.bootstrap --from-env) ---
BOOTSTRAP_CONDOMINIO_ID=1
BOOTSTRAP_ADMIN_NOMBRE=Presidente Junta Inicial
BOOTSTRAP_ADMIN_CEDULA=V-00000001
BOOTSTRAP_ADMIN_CORREO=
BOOTSTRAP_ADMIN_TELEFONO=+584120000000
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROL=PRESIDENTE

