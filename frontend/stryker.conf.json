{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.vue",
    "!src/main.ts",
    "!src/**/*.unit.ts",
    "!src/**/*.d.ts"
  ],
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
